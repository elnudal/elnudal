---
import { formatPrice } from '../lib/mercadolibre.js';

const { product } = Astro.props;
const soldOut = product.available_quantity <= 0;
---

<article class="flex flex-col overflow-hidden rounded-[14px] border border-line bg-surface transition duration-200 hover:-translate-y-[3px] hover:shadow-[0_12px_30px_-18px_rgba(20,23,31,0.35)]">
  <div class="relative aspect-square bg-[#f0f1f4]">
    <img
      src={product.thumbnail}
      alt={product.title}
      loading="lazy"
      width="300"
      height="300"
      class="block h-full w-full object-cover"
    />
    {product.free_shipping && !soldOut && (
      <span class="absolute left-[0.6rem] top-[0.6rem] rounded-full bg-accent-wash px-[0.55rem] py-[0.25rem] text-[0.72rem] font-semibold text-accent-deep">
        Envío gratis
      </span>
    )}
    {soldOut && (
      <span class="absolute left-[0.6rem] top-[0.6rem] rounded-full bg-[#f1d6d6] px-[0.55rem] py-[0.25rem] text-[0.72rem] font-semibold text-[#8a2b2b]">
        Sin stock
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-[0.55rem] p-4">
    <h3 class="line-clamp-2 font-body text-[0.98rem] font-normal leading-[1.35] tracking-normal text-ink">
      {product.title}
    </h3>
    <p class="my-2 font-display text-sm font-bold">
      {formatPrice(product.price, product.currency)}
    </p>

    {soldOut ? (
      <span class="btn btn--ghost mt-auto" aria-disabled="true">No disponible</span>
    ) : (
      <a
        class="btn btn--primary mt-auto"
        href={product.permalink}
        target="_blank"
        rel="noopener noreferrer"
      >
        Comprar
      </a>
    )}
  </div>
</article>